# ============================================================
#  Veless - przykładowa konfiguracja.
#  Skopiuj do `.env` i uzupełnij. Plik .env trzymaj POZA public_html.
# ============================================================

APP_ENV=production
# Tryb pracy: server (hosting, zamówienia przychodzą webhookami) albo local (Docker na
# własnym komputerze: CRM sam odpytuje kanały co minutę). Patrz docker/README.md.
APP_MODE=server
# Adres panelu w trybie lokalnym (linki w mailach). Na hostingu ustawiasz go w panelu.
APP_URL=
APP_DEBUG=false
# Publiczna wersja demonstracyjna (np. demo.veless.pl): konto demo/demo, bez wysyłki, integracji
# i plików, reset co noc przez cli/demo_reset.php. Na prawdziwej instalacji zostaw 0.
DEMO_MODE=0
# Sekret chroniący endpoint workera, gdyby był odpalany przez ping HTTP
WORKER_HTTP_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# Hasło pierwszego konta admina panelu (login: admin).
# Jeśli puste, instalator wygeneruje losowe i zapisze do storage/ADMIN_PASSWORD.txt.
ADMIN_DEFAULT_PASSWORD=

# --- Sesja panelu ---
# Ile dni trzymać zalogowanie w panelu (przesuwane przy każdej aktywności).
# Domyślnie 30. Pliki sesji trafiają do storage/sessions, poza wspólne /tmp hostingu.
SESSION_ADMIN_DAYS=30

# --- Baza MySQL (dane z panelu DirectAdmin) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uzytkownik_pase
DB_USER=uzytkownik_pase
DB_PASS=
DB_CHARSET=utf8mb4

# --- Allegro OAuth 2.0 ---
# https://apps.developer.allegro.pl/  (Client ID / Secret aplikacji)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=https://twojadomena.pl/auth_allegro_callback.php
# Środowisko: 'sandbox' (testy) lub 'production'
ALLEGRO_ENV=sandbox
# User-Agent wysyłany z każdym zapytaniem do API Allegro (wymagane, inaczej ryzyko
# zablokowania klucza). Wygodniej edytować w panelu: Marketplace -> Allegro -> Ustawienia.
ALLEGRO_APP_NAME=Veless
ALLEGRO_APP_VERSION=1.0
ALLEGRO_APP_URL=

# --- WooCommerce REST API (klucze: WP Admin -> WooCommerce -> Ustawienia -> Zaawansowane -> REST API) ---
WOO_BASE_URL=https://twojsklep.pl
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Sekret webhooka Woo (WooCommerce -> Ustawienia -> Zaawansowane -> Webhooki)
WOO_WEBHOOK_SECRET=

# --- wFirma API ---
# https://wfirma.pl  -> Ustawienia -> API
WFIRMA_BASE_URL=https://api2.wfirma.pl
WFIRMA_ACCESS_KEY=
WFIRMA_SECRET_KEY=
WFIRMA_APP_KEY=
WFIRMA_COMPANY_ID=

# --- Logowanie dwuetapowe (Google Authenticator / TOTP) ---
# Nazwa konta w aplikacji. Dla kilku instalacji ustaw różne nazwy.
TOTP_ISSUER="Veless"
# 0 = opcjonalne; 1 = administrator musi skonfigurować 2FA przed wejściem do panelu.
TOTP_REQUIRE_ADMIN=0
# Opcjonalna bezwzględna ścieżka klucza, poza public/. Domyślnie storage/security/totp.key.
# Plik tworzy się przy pierwszej konfiguracji. Zachowaj jego BEZPIECZNĄ kopię!
# TOTP_KEY_FILE=/bezpieczny/katalog/crm-totp.key

# --- Encrypted backups (CLI only; never put these directories under public_html) ---
# BACKUP_DIR=/private/backups/crm
# BACKUP_WEB_ROOT=/home/account/public_html
# BACKUP_KEY_FILE=/private/keys/crm-backup.key

# --- Worker / rate limiting ---
# Ile zadań przetworzyć w jednym przebiegu crona
WORKER_BATCH_SIZE=20
# Minimalny odstęp (ms) między żądaniami do Allegro w obrębie jednego przebiegu
ALLEGRO_MIN_INTERVAL_MS=350

# Wgrywanie wtyczek (ZIP) przez panel: 1 = dozwolone (domyślnie), 0 = wyłączone.
# Na produkcji zalecane 0 - wtyczka to kod PHP z pełnym dostępem do bazy i kluczy API,
# więc trafia wtedy tylko przez FTP albo repozytorium (z przeglądem kodu).
# PLUGIN_UPLOAD=0
