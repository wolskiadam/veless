# Panel admina. Blokuj bezpośredni dostęp do plików includowanych
# (sama logika - bez sesji - i tak by je odrzuciła, ale lepiej zablokować z serwera).

Options -Indexes

<FilesMatch "^(db_admin|auth|bootstrap_admin|header|footer|_[A-Za-z0-9_]+)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
